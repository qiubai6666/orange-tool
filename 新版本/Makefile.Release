clean: compiler_clean 
	-$(DEL_FILE) release/main.o release/menuwidget.o release/deviceinfowindow.o release/repairwindow.o release/payloadwindow.o release/devicecheckwindow.o release/configwindow.o release/processmanager.o release/resourceextractor.o release/uihelper.o release/devicemanager.o release/qrc_resources.o release/moc_menuwidget.o release/moc_deviceinfowindow.o release/moc_passworddialog.o release/moc_repairwindow.o release/moc_payloadwindow.o release/moc_devicecheckwindow.o release/moc_configwindow.o release/moc_devicemanager.o
	-$(DEL_FILE) release/app_res.o

distclean: clean 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) $(DESTDIR_TARGET)
	-$(DEL_FILE) Makefile.Release

mocclean: compiler_moc_header_clean compiler_moc_objc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_objc_header_make_all compiler_moc_source_make_all

check: first

benchmark: first

compiler_no_pch_compiler_make_all:
compiler_no_pch_compiler_clean:
compiler_rcc_make_all: release/qrc_resources.cpp
compiler_rcc_clean:
	-$(DEL_FILE) release/qrc_resources.cpp
